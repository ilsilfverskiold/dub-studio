# Dub Studio keys — copy to .env and fill in, OR paste them in the app (sidebar → API KEYS),
# which writes this exact file for you. Never commit .env.

# Local voice/background separation model: mdx (fast, default) or roformer (noticeably better
# quality, but heavier — ~600 MB one-time download and slower per clip).
separation_model=roformer

# ElevenLabs — voice isolation + speech-to-speech. The key needs the voices_read permission.
# https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# Google Gemini — watches each clip once to propose the cast (~$0.02/clip). Optional if you
# build the cast yourself in the app.
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Hugging Face READ token — loads the pyannote diarization model (free, but gated):
# 1) create a token at https://huggingface.co/settings/tokens
# 2) accept the terms once at https://huggingface.co/pyannote/speaker-diarization-community-1
HF_TOKEN=
